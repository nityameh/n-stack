#!/bin/sh
# n-stack CLI shim. Git Bash on Windows gives scripts /c/... paths that native node.exe
# can't open, so convert with cygpath when it exists (it's absent on macOS/Linux).
here=$(cd "$(dirname "$0")" && pwd)
entry="$here/../lib/main.cjs"
if command -v cygpath >/dev/null 2>&1; then entry=$(cygpath -w "$entry"); fi
exec node "$entry" gate "$@"
